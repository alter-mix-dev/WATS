import os
from fastapi import FastAPI, Request, Response
from fastapi.responses import PlainTextResponse
import requests

app = FastAPI()

# Token de verificación inventado por ti para registrar el webhook en Meta
WHATSAPP_VERIFY_TOKEN = os.environ.get("VERIFY_TOKEN", "MiTokenEscolar123")
# Token de acceso de WhatsApp que te da Meta para enviar respuestas
WHATSAPP_TOKEN = os.environ.get("WHATSAPP_TOKEN")

@app.get("/")
def home():
    return {"status": "Asistente de WhatsApp Activo"}

# 1. PASO OBLIGATORIO: Meta usa este endpoint para validar que tu URL es real
@app.get("/webhook", response_class=PlainTextResponse)
def verificar_webhook(request: Request):
    params = request.query_params
    mode = params.get("hub.mode")
    token = params.get("hub.verify_token")
    challenge = params.get("hub.challenge")

    if mode == "subscribe" and token == WHATSAPP_VERIFY_TOKEN:
        print("¡Webhook Verificado con Éxito!")
        return challenge
    return Response(content="Token de verificación inválido", status_code=403)

# 2. RECIBIR MENSAJES: Aquí llega lo que escribe el usuario en WhatsApp
@app.post("/webhook")
async def recibir_mensaje(request: Request):
    body = await request.json()
    
    try:
        # Extraemos el mensaje de la estructura JSON de WhatsApp
        entry = body["entry"][0]
        changes = entry["changes"][0]
        value = changes["value"]
        
        if "messages" in value:
            message = value["messages"][0]
            whatsapp_id = message["from"] # Teléfono del usuario
            
            if message["type"] == "text":
                texto_usuario = message["text"]["body"]
                print(f"Mensaje recibido de {whatsapp_id}: {texto_usuario}")
                
                # --- AQUÍ CONECTAS TU IA ---
                # Ejemplo: respuesta_ia = llamar_a_tu_modelo_ia(texto_usuario)
                respuesta_ia = f"Hola, soy tu asistente IA escolar. Recibí tu mensaje: '{texto_usuario}'"
                # ----------------------------
                
                # Enviar la respuesta de vuelta al WhatsApp del usuario
                enviar_mensaje_whatsapp(whatsapp_id, respuesta_ia)
                
    except Exception as e:
        print(f"Error procesando el JSON de WhatsApp: {e}")
        
    return {"status": "success"}

def enviar_mensaje_whatsapp(telefono_destino, texto_respuesta):
    if not WHATSAPP_TOKEN:
        print("Falta el WHATSAPP_TOKEN, no se puede responder.")
        return

    url = "https://facebook.com"
    headers = {
        "Authorization": f"Bearer {WHATSAPP_TOKEN}",
        "Content-Type": "application/json"
    }
    payload = {
        "messaging_product": "whatsapp",
        "to": telefono_destino,
        "type": "text",
        "text": {"body": texto_respuesta}
    }
    
    response = requests.post(url, json=payload, headers=headers)
    print(f"Envío a WhatsApp: {response.status_code} - {response.text}")

